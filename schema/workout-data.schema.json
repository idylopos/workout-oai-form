{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/form/workout-data.schema.json",
  "title": "Form private workout data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "plan", "sessions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exportedAt": { "type": "string", "maxLength": 60 },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "days"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "days": { "type": "array", "minItems": 1, "maxItems": 14, "items": { "$ref": "#/$defs/day" } }
      }
    },
    "sessions": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/session" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sets", "reps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sets": { "type": "integer", "minimum": 1, "maximum": 20 },
        "reps": { "type": "string", "minLength": 1, "maxLength": 80 },
        "restSeconds": { "type": "integer", "minimum": 0, "maximum": 1800 },
        "cue": { "type": "string", "minLength": 1, "maxLength": 500 },
        "substitution": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "shortLabel", "focus", "exercises"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "shortLabel": { "type": "string", "minLength": 1, "maxLength": 12 },
        "focus": { "type": "string", "minLength": 1, "maxLength": 160 },
        "weekday": { "type": "integer", "minimum": 0, "maximum": 6 },
        "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 600 },
        "exercises": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/exercise" } }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exerciseId", "completed"],
      "properties": {
        "exerciseId": { "$ref": "#/$defs/id" },
        "completed": { "type": "boolean" },
        "load": { "type": "string", "minLength": 1, "maxLength": 40 },
        "reps": { "type": "string", "minLength": 1, "maxLength": 40 },
        "rpe": { "type": "string", "minLength": 1, "maxLength": 20 },
        "discomfort": { "type": "string", "minLength": 1, "maxLength": 20 }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "dayId", "results"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "type": "string", "minLength": 1, "maxLength": 20 },
        "dayId": { "$ref": "#/$defs/id" },
        "completedAt": { "type": "string", "minLength": 1, "maxLength": 60 },
        "notes": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "results": { "type": "array", "items": { "$ref": "#/$defs/result" } }
      }
    }
  }
}

